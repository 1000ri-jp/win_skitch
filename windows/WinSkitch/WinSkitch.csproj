<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetPlatformDisplayName>Windows</TargetPlatformDisplayName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>WinSkitch</RootNamespace>
    <AssemblyName>WinSkitch</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinSkitch.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <Version>1.0.0</Version>
    <Description>Windows screen capture and annotation editor</Description>
    <!-- WPF owns DPI awareness through the manifest; WinForms is used only for the tray. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\WinSkitch.png" />
    <Resource Include="Assets\WinSkitch.ico" />
  </ItemGroup>
</Project>
